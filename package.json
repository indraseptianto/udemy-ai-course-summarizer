{
  "name": "udemy-ai-course-summarizer",
  "version": "1.0.0",
  "description": "Production-ready Chrome/Brave extension that converts Udemy course transcripts into structured, AI-summarized study notes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:clean && npm run build:vite && npm run build:icons && npm run build:manifest",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:vite": "vite build",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:manifest": "node scripts/copy-public.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
